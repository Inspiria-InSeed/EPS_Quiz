# Copy this file to .env for local development and replace every placeholder.
# Never commit backend/.env or paste real secrets into .env.example.

# Required backend database and JWT signing key
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SECRET_KEY=replace_with_a_unique_random_secret_at_least_32_bytes_long

# Optional previous key only during a planned JWT key rotation
# SECRET_KEY_PREVIOUS=replace_with_previous_secret_temporarily

# Supabase Storage (server-side key only; never expose in frontend code)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_server_only_supabase_secret_key
SUPABASE_MEDIA_BUCKET=exam-media

# SMTP for email and OTP delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password_or_app_password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=EPS TOPIK EXAM

# Email validation used during student registration
ZEROBOUNCE_API_KEY=replace_with_your_zerobounce_api_key

# Frontend origins allowed to call this backend (comma-separated)
CORS_ORIGINS=http://localhost:5500,https://YOUR-FRONTEND-PROJECT.vercel.app

# Optional settings
# OTP_EXPIRE_MINUTES=5
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_MAX_ATTEMPTS=5
# DB_POOL_SIZE=1
# DB_MAX_OVERFLOW=0
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=300
# ADMIN_EMAIL=authorized-admin@example.com
# DEVELOPER_EMAIL=authorized-developer@example.com
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# STUDENT_ACCESS_TOKEN_EXPIRE_MINUTES=180
# ALGORITHM=HS256